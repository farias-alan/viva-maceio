# Ambiente dos testes E2E (Laravel Dusk).
# Copie para .env.dusk.local. Durante "php artisan dusk" o Dusk troca
# temporariamente o .env por este arquivo e depois restaura o original.

APP_NAME="Viva Maceio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Banco EXCLUSIVO dos testes. Use o caminho ABSOLUTO do arquivo.
# O DuskTestCase se recusa a rodar se o nome do arquivo nao terminar em dusk.sqlite.
DB_CONNECTION=sqlite
DB_DATABASE=C:/caminho/para/viva-maceio/database/dusk.sqlite

# Sessao e cache em arquivo: nao dependem do banco, que e recriado a cada teste.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Senha FICTICIA da conta de teste criada pelo DuskSeeder.
DUSK_USER_PASSWORD=senha-ficticia-123
